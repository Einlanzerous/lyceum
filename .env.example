# Copy to .env and fill in the lyceum_user password (from
# ~/construct-server/.env LYCEUM_DB_PASSWORD). Connects to the shared
# construct-server Postgres 16 on 127.0.0.1:5432.
DATABASE_URL=postgres://lyceum_user:CHANGE_ME@localhost:5432/lyceum?sslmode=disable
TEST_DATABASE_URL=postgres://lyceum_user:CHANGE_ME@localhost:5432/lyceum_test?sslmode=disable
LYCEUM_ADDR=:8080
LYCEUM_DATA_DIR=data/blobs

# --- Cross-platform wrappers (Phase 3, LYCM-300) ---

# Extra CORS origins allowed to call this server. The Wails desktop shell
# loads the SPA from its own origin (http://wails.localhost) and calls the backend
# cross-origin; those built-in native origins are ALWAYS allowed, so the
# wrappers work with this left empty. Add entries (comma-separated) only to
# allow other origins — e.g. a second web deployment — or set to "*" to allow
# any. The same-origin web build needs nothing here.
#   LYCEUM_CORS_ORIGINS=https://reader.example.com,http://192.168.1.10:8080
LYCEUM_CORS_ORIGINS=

# --- Accounts (LYCM-801) ---

# Require a signed-in user on the reader core (/library, /upload, /sync,
# /books/*, /inventory, /ingest/*). OFF by default, so a fresh single-user
# self-host starts with no configuration at all.
#
# While it is off the server behaves exactly as it did before accounts existed —
# the reader core is open and every request is served as the owner. A household
# turns it on; the web and Android apps both ship a sign-in screen to meet it.
#
# This has no effect on LYCEUM_API_TOKENS below: those service-token scopes guard
# the ecosystem hooks and are enforced either way.
#
# LEAVING THIS LINE OUT IS NOT THE SAME AS SETTING IT FALSE on a server that has
# a household on it (LYCM-116). With enforcement off every request is served as
# the owner, so several accounts collapse into one identity — everyone reads the
# owner's bookmarks and read marks, and their own reading positions are written
# onto the owner's rows, silently. The server therefore refuses to start when it
# holds more than one account and this is off; set it true there. A single-user
# install is unaffected and still needs no configuration at all.
LYCEUM_AUTH=false

# The owner account: the one person who can invite and remove others, and who
# adopts all reading history recorded before accounts existed. Migration 0011
# seeds the row; these land the real identity on it at every boot.
#
# On first boot the server prints a one-time sign-in invite for the owner. Redeem
# it once in the app (Settings -> Sign in); `lyceum mint-token` issues another if
# it is lost. Other people are added with POST /admin/users, which returns their
# own one-time invite.
LYCEUM_OWNER_EMAIL=
LYCEUM_OWNER_NAME=

# Cross-device sign-in links (LYCM-88, LYCM-102). Both are origins Lyceum turns
# into a scannable `<origin>/sign-in?token=…` QR; both are optional, and each
# addresses a different reader.
#
# LYCEUM_PUBLIC_URL is for the operator at a terminal: it is what `lyceum
# mint-token` and the first-boot owner invite render as an ASCII QR. Unset, those
# print the raw token only.
#
# LYCEUM_MOBILE_BASE_URL is for everyone being invited: when set, every minted
# invite carries a ready-made sign_in_url built from it, and the web and Android
# apps show that as the QR instead of guessing an origin from their own address.
# Set it to the origin a PHONE can reach. Behind Cloudflare Access these differ
# and the difference is the whole point: the browser mints invites on the
# SSO-gated hostname, and a QR built from that sends the scanner to a login wall
# no bearer token opens. Point this at the direct, bearer-authenticated host.
#
# Unset is correct on a LAN, where the address the owner is looking at is the same
# one the phone can use — clients then build the link locally, as they always did.
LYCEUM_PUBLIC_URL=
LYCEUM_MOBILE_BASE_URL=

# Cloudflare Access SSO (LYCM-803). When Lyceum sits behind Cloudflare Access
# (the tunnelled Zero Gravity edge), the browser SPA trades its edge-verified
# identity for a Lyceum session automatically — a household member behind the
# gate signs in with no second step. Set BOTH to enable it; either unset leaves
# the /auth/sso/cloudflare endpoint reporting sso_disabled and clients fall back
# to invite/pairing sign-in. Native apps (Android/desktop) reach the API directly
# over Tailscale and never use this path.
#
# Both are PUBLIC identifiers, not secrets: the team domain and the Access
# application's Audience (AUD) tag, both from the Zero Trust dashboard. A
# CF-verified email must match an existing Lyceum account — unknown emails are
# refused, never auto-provisioned. Requires LYCEUM_AUTH=true to have any effect.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Ecosystem & Agent Integration (Phase 4, LYCM-400) ---

# Bearer tokens guarding the /eidolon/* hooks and the send-to-kindle routes
# (LYCM-405). Comma-separated entries of the form  token=scope|scope  with
# scopes drawn from: eidolon:read, delivery:send. Leave empty to keep the
# integration surface closed (every protected request 401s).
# Example:
#   LYCEUM_API_TOKENS=eidolon-localdev=eidolon:read,kindle-bot=delivery:send
LYCEUM_API_TOKENS=

# "Send to Kindle" SMTP relay (LYCM-401/402). Delivery is disabled unless both
# LYCEUM_SMTP_HOST and LYCEUM_SMTP_FROM are set. TLS is one of: starttls
# (default, port 587), implicit (port 465), none (local capture only).
LYCEUM_SMTP_HOST=
LYCEUM_SMTP_PORT=587
LYCEUM_SMTP_USERNAME=
LYCEUM_SMTP_PASSWORD=
LYCEUM_SMTP_FROM=
LYCEUM_SMTP_TLS=starttls

# Default Kindle recipient and whether every uploaded book is auto-delivered.
LYCEUM_KINDLE_ADDR=
LYCEUM_KINDLE_AUTO_SEND=false

# --- Acquisition: folder ingest (LYCM-601) ---

# Watch a directory recursively and ingest new EPUBs through the same path as
# /upload (validate -> SHA-256 dedup -> store -> stamp ISBN onto inventory).
# Point this at the acquisition stack's book library
# (~/construct-server/services/argosy-acquisition imports to /data/media/books).
# Leave empty to disable folder ingest. INTERVAL is the poll period in seconds.
LYCEUM_BOOKS_WATCH_DIR=
LYCEUM_BOOKS_WATCH_INTERVAL=15

# --- Acquisition: Bindery grab backend (LYCM-35) ---

# The live acquirer that turns a `wanted` ISBN into an actual DRM-free grab via
# the Bindery service in ~/construct-server/services/argosy-acquisition. BASE_URL
# is Bindery's address (e.g. http://localhost:8787); API_KEY comes from Bindery's
# Settings -> Security.
#
# BOTH must be set to enable it. If either is empty the backend falls back to a
# logging no-op: `find_digital` requests still flip inventory to `wanted`, but no
# grab is ever requested — so a deploy that forgets these looks healthy while
# acquiring nothing. The server logs which mode it picked at boot; grep for
# "bindery acquirer" / "no-op acquirer".
LYCEUM_BINDERY_BASE_URL=
LYCEUM_BINDERY_API_KEY=
