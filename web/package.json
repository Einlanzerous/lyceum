{
  "name": "lyceum-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Lyceum web reader — Vue 3 + epub.js client for the Phase 1 Go backend.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:native": "vue-tsc --noEmit && vite build --mode native",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "epubjs": "^0.3.93",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.2",
    "prettier": "^3.9.10",
    "typescript": "~5.4.5",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "postcss": "^8.5.31",
    "nanoid": "^3.3.16",
    "source-map-js": "^1.2.2",
    "js-yaml": "^4.3.2",
    "postcss-selector-parser": "^7.1.7"
  }
}
